// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        BigInt      @id @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  worldUserId BigInt
  serverId BigInt
  channelId BigInt
  content Json
  likeCount Int @default(1)
  dislikeCount Int @default(1)
  interactions Int @default(2)
  channelName String?
  serverName String?
  userName String?
}

model WorldUser {
  id      BigInt @id @unique // This uses your discord accounts ID
  worldId BigInt @default(1)
  world   World? @relation(fields: [worldId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  globalBalance Int         @default(0)
  lastKnownName String      @default("?")
  localUsers    LocalUser[]
}

model LocalUser {
  id              BigInt     @id // This is the discord server id!
  discordServerId BigInt?
  worldUserId     BigInt?
  server          Server?    @relation(fields: [discordServerId], references: [id])
  worldUser       WorldUser? @relation(fields: [worldUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  balance   Int      @default(0)
}

model Server {
  id               BigInt         @id @unique // This uses the discord server ID
  worldId          BigInt
  world            World?         @relation(fields: [worldId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  users            LocalUser[]
  channelSettings  ChannelSettings[] 
  settings         ServerSettings? 
}

// These two settings tables are exactly the same fields wise but are separated due to their different IDs. It may collide if we combine them into one.
model ServerSettings {
  id        BigInt   @id @unique // Server ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  server    Server  @relation(fields: [id], references: [id])
  settings Json?
  lastKnownName String?     @default("?")
}

model ChannelSettings {
  id        BigInt   @id @unique // Channel ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastKnownName String?      @default("?")
  serverId  BigInt
  server    Server  @relation(fields: [serverId], references: [id])
  settings Json?
}

model World {
  id        BigInt      @id @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  users     WorldUser[]
  servers   Server[]
}

// ---------------------------------------------------------------------------
// Message statistics (/stats)
// One small row per Discord message. The send time is derived from the
// snowflake ID, so time-range filters use the primary key directly.
// ---------------------------------------------------------------------------
model MessageLog {
  id        BigInt  @id // Discord message ID (snowflake)
  channelId BigInt // Top-level channel; thread messages use their parent channel
  authorId  BigInt
  isBot     Boolean @default(false)

  // isBot is part of every index so filtered scans never touch the table rows.
  @@index([authorId, isBot, id])
  @@index([channelId, isBot, id])
}

// Server-wide message counts per UTC hour, kept up to date by SQLite triggers on
// MessageLog (see src/stats/store.ts). Makes all-time charts and top days fast.
model MessageHourStat {
  hour  Int // Hours since 1970-01-01 UTC
  isBot Boolean
  count Int

  @@id([hour, isBot])
}

// Last known display name of message authors, used for chart labels.
model MessageAuthor {
  id        BigInt   @id
  name      String
  updatedAt DateTime @updatedAt
}

// History scan and gap catch-up progress per channel or thread.
model MessageSyncChannel {
  id             BigInt   @id // Channel or thread ID
  parentId       BigInt? // Parent channel for threads
  name           String?
  backfillCursor BigInt? // Oldest message ID already scanned
  backfillDone   Boolean  @default(false)
  watermark      BigInt? // Everything from the first tracked message up to this ID is stored
  fetchedCount   Int      @default(0)
  lastError      String?
  updatedAt      DateTime @updatedAt
}

model MessageStatsState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
