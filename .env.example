# Copy this file to .env and fill in your Discord bot credentials.
# All credentials must remain private; .env is excluded by .gitignore.
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN"
DISCORD_APPLICATION_ID="YOUR_APPLICATION_ID"
DISCORD_GUILD_ID="YOUR_SERVER_ID"

# Relative to prisma/schema.prisma: D:\\whtba-bot\\prisma\\whtba.db by default.
# SQLite is a local file and does not require PostgreSQL or a database password.
DATABASE_URL="file:./whtba.db"
